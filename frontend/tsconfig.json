{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ES2015",
    "moduleResolution": "node",
    "lib": ["ES2018", "DOM"],
    "outDir": "./js",
    "rootDir": "./js",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["js/*.ts"],
  "exclude": ["node_modules"]
}